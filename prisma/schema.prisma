generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  role                String               @default("CLIENT")
  phone               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accounts            Account[]
  sessions            Session[]
  leads               Lead[]
  briefs              Brief[]
  bookings            Booking[]
  campaigns           Campaign[]
  paymentTransactions PaymentTransaction[]
  reviewedPayments    PaymentTransaction[] @relation("PaymentReviewer")
  subscriptions       UserSubscription[]
  notifications       Notification[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.NVarChar(Max)
  access_token      String?  @db.NVarChar(Max)
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.NVarChar(Max)
  session_state     String?  @db.NVarChar(Max)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Booking {
  id        String   @id @default(cuid())
  date      DateTime
  name      String
  phone     String
  status    String   @default("NEW")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())

  @@unique([date, phone])
}

model DayCapacity {
  date     DateTime @id
  capacity Int      @default(6)
  blocked  Boolean  @default(false)
}

model Lead {
  id        String        @id @default(cuid())
  type      String
  status    String        @default("NEW")
  name      String
  email     String?
  phone     String
  payload   String
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  brief     Brief?
  quote     PackageQuote?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Brief {
  id                         String    @id @default(cuid())
  leadId                     String    @unique
  lead                       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientName                 String
  brandName                  String
  briefDate                  DateTime?
  email                      String?
  phone                      String
  mainGoals                  String?
  roleModel                  String?
  competitorsLinks           String?
  brandIdentity              String?
  brandLevel                 String?
  customerSegment            String?
  businessType               String?
  socialPlatforms            String
  brandSlogan                String?
  preferredColors            String?
  colorNumbers               String?
  toneOfVoice                String
  advertisingPlatforms       String
  adsBudget                  String?
  targetAge                  String?
  branchesNumber             Int?
  locations                  String?
  gender                     String?
  languages                  String
  platformLinks              String?
  notes                      String?
  businessModel              String?
  digitalMarketingExperience String?
  uniqueSellingPoints        String?
  planObjectives             String?
  userId                     String?
  user                       User?     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt                  DateTime  @default(now())
}

model PackageQuote {
  id        String   @id @default(cuid())
  leadId    String   @unique
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  planName  String?
  addOnIds  String
  total     Int
  createdAt DateTime @default(now())
}

model Project {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  category      String
  image         String
  imageAlt      String
  details       String?  @db.NVarChar(Max)
  videoUrl      String?
  content       String?  @db.NVarChar(Max)
  caseStudyData String?  @db.NVarChar(Max)
  published     Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Industry {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  icon        String
  headline    String
  description String
  order       Int              @default(0)
  clients     IndustryClient[]
}

model IndustryClient {
  id         String   @id @default(cuid())
  industryId String
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  name       String
  result     String
  order      Int      @default(0)
}

model ClientLogo {
  id             String @id @default(cuid())
  name           String
  category       String
  file           String
  objectPosition String @default("50% 50%")
  size           String @default("md")
  order          Int    @default(0)
}

model ValueProp {
  id          String @id @default(cuid())
  icon        String
  title       String
  description String
  order       Int    @default(0)
}

model TeamMember {
  id    String  @id @default(cuid())
  name  String
  role  String
  photo String?
  order Int     @default(0)
}

model AboutPageContent {
  id               Int      @id @default(1)
  heroEyebrow      String
  heroTitle        String
  heroHighlight    String
  heroSubtitle     String   @db.NVarChar(Max)
  heroStats        String   @db.NVarChar(Max)
  serviceCards     String   @db.NVarChar(Max)
  processEyebrow   String
  processTitle     String
  processSteps     String   @db.NVarChar(Max)
  founderEyebrow   String
  founderName      String
  founderRole      String
  founderPhoto     String?
  founderBio       String   @db.NVarChar(Max)
  founderBullets   String   @db.NVarChar(Max)
  founderStats     String   @db.NVarChar(Max)
  teamEyebrow      String
  teamTitle        String
  metricsTitle     String
  metrics          String   @db.NVarChar(Max)
  reasonsTitle     String
  reasons          String   @db.NVarChar(Max)
  termsTitle       String
  termsText        String   @db.NVarChar(Max)
  termsButtonLabel String
  termsItems       String   @db.NVarChar(Max)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ServiceItem {
  id          String @id @default(cuid())
  icon        String
  eyebrow     String
  title       String
  description String
  cta         String
  order       Int    @default(0)
}

model PackagePlan {
  id                  String               @id @default(cuid())
  name                String               @unique
  tagline             String
  price               String
  period              String
  description         String
  features            String
  cta                 String
  featured            Boolean              @default(false)
  order               Int                  @default(0)
  paymentTransactions PaymentTransaction[]
  subscriptions       UserSubscription[]
}

model ManualPaymentSettings {
  id                       Int      @id @default(1)
  vodafoneCashEnabled      Boolean  @default(true)
  vodafoneCashNumber       String?
  vodafoneCashSecondNumber String?
  vodafoneCashAccountName  String?
  vodafoneCashInstructions String?  @db.NVarChar(Max)
  instapayEnabled          Boolean  @default(true)
  instapayAddress          String?
  instapayAccountName      String?
  instapayInstructions     String?  @db.NVarChar(Max)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model PaymentTransaction {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  planId               String
  plan                 PackagePlan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  planNameSnapshot     String
  amount               Decimal     @db.Decimal(12, 2)
  currency             String      @default("EGP")
  paymentMethod        String
  senderName           String
  senderPhone          String
  transactionReference String?
  proofImage           String
  proofMimeType        String
  transferDate         DateTime
  transferTime         String?
  notes                String?     @db.NVarChar(Max)
  status               String      @default("PENDING")
  adminNotes           String?     @db.NVarChar(Max)
  reviewedBy           String?
  reviewer             User?       @relation("PaymentReviewer", fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([userId, status])
  @@index([planId])
  @@index([paymentMethod])
  @@index([status, createdAt])
}

model UserSubscription {
  id                   String      @id @default(cuid())
  userId               String      @unique
  user                 User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  planId               String
  plan                 PackagePlan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  planNameSnapshot     String
  status               String      @default("ACTIVE")
  startsAt             DateTime    @default(now())
  endsAt               DateTime?
  activatedByPaymentId String      @unique
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([planId])
  @@index([status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PackageAddOn {
  id          String @id
  label       String
  description String
  price       Int
  order       Int    @default(0)
}

model CustomPackageSettings {
  id                     Int      @id @default(1)
  quantityDiscountStart  Int      @default(5)
  quantityDiscountPercent Int     @default(10)
  maxQuantityDiscount    Int      @default(25)
  annualDiscountPercent  Int      @default(15)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model HeroStats {
  id      Int   @id @default(1)
  growth  Int
  revenue Int
  roi     Float
}

model ClientStats {
  id                 Int @id @default(1)
  happyClients       Int
  successfulProjects Int
}

model ResultCard {
  id           String @id @default(cuid())
  stat         String
  title        String
  description  String
  tone         String
  industrySlug String
  image        String
  imageAlt     String
  order        Int    @default(0)
}

model Platform {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)
}

model SiteSettings {
  id      Int    @id @default(1)
  phone   String
  address String
  mapUrl  String
  socials String
}

model Campaign {
  id             String                  @id @default(cuid())
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  platform       String
  status         String                  @default("ACTIVE")
  budget         Int
  spend          Int
  revenue        Int
  conversions    Int
  roas           Float
  conversionRate Float
  cac            Int
  impressions    Int
  sessions       Int
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  dailyMetrics   CampaignDailyMetric[]
  trafficSources CampaignTrafficSource[]
  insights       CampaignInsight[]
}

model CampaignDailyMetric {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date        DateTime
  conversions Int
  sessions    Int
  revenue     Int
  spend       Int

  @@unique([campaignId, date])
}

model CampaignTrafficSource {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  source      String
  color       String
  sessions    Int
  percentage  Int
  conversions Int
}

model CampaignInsight {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tone        String
  title       String
  description String
  createdAt   DateTime @default(now())
}
