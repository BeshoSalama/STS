{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/src/*"]
    }
  },
  "include": ["backend/**/*.ts", "prisma/**/*.ts", "frontend/src/lib/**/*.ts", "frontend/src/types/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "frontend/.next"]
}
