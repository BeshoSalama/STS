{
  "name": "sts-agency",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n FRONTEND,BACKEND -c cyan,magenta \"npm run frontend\" \"npm run backend\"",
    "frontend": "cd frontend && next dev -p 3000",
    "backend": "dotnet watch --project backend/src/STS.Api/STS.Api.csproj run --urls http://localhost:4000",
    "backend:start": "dotnet run --project backend/src/STS.Api/STS.Api.csproj --urls http://localhost:4000",
    "build": "cd frontend && next build",
    "start": "cd frontend && next start -p 3000",
    "lint": "cd frontend && next lint",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.16.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "gsap": "^3.12.7",
    "lenis": "^1.1.20",
    "lucide-react": "^0.462.0",
    "next": "14.2.15",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.1"
  }
}
